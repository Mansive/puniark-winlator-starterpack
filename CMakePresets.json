{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-win32-local",
      "displayName": "Windows MinGW Win32",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/.cmake/build/mingw-win32-local",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-win32-linux",
      "displayName": "Linux cross-compile Win32",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.cmake/build/mingw-win32-linux",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw32.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-win32-local",
      "configurePreset": "mingw-win32-local"
    },
    {
      "name": "mingw-win32-linux",
      "configurePreset": "mingw-win32-linux"
    }
  ]
}
